# ==============================================================================
# PICC-PC-NNP-Config - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Spring Boot microservice listens
SERVER_PORT=8888

# Active Spring Profiles (e.g., jdbc,local or local or jdbc)
SPRING_PROFILES_ACTIVE=jdbc,local

# Root logging level (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL Backend)
# ------------------------------------------------------------------------------
# PostgreSQL Database host and port
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nnp-core-comp

# Database Credentials
DB_USER=postgres
DB_PASSWORD=postgres

# Full JDBC Connection URL
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# HikariCP Connection Pool Settings
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=10

# ------------------------------------------------------------------------------
# 3. Cryptographic Services (Quantum-Safe Integration)
# ------------------------------------------------------------------------------
# Base URL for the external NNP Quantum-Safe Cryptographic Service (X25519 + ML-KEM-768)
QUANTUM_SAFE_SERVICE_URL=http://localhost:8080
